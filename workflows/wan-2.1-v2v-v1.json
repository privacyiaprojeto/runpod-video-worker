{
  "schema_version": "privacy-comfyui-workflow-v1",
  "engine": "wan-2.1-v2v",
  "workflow_version": "1",
  "description": "Wan 2.1 VACE Video-to-Video workflow using an approved identity image and a private base video.",
  "prompt": {
    "1": {
      "inputs": {
        "unet_name": "wan2.1_vace_14B_fp16.safetensors",
        "weight_dtype": "default"
      },
      "class_type": "UNETLoader",
      "_meta": {"title": "Load Wan VACE Model"}
    },
    "2": {
      "inputs": {
        "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "type": "wan",
        "device": "default"
      },
      "class_type": "CLIPLoader",
      "_meta": {"title": "Load Wan Text Encoder"}
    },
    "3": {
      "inputs": {"vae_name": "wan_2.1_vae.safetensors"},
      "class_type": "VAELoader",
      "_meta": {"title": "Load Wan VAE"}
    },
    "4": {
      "inputs": {"text": "", "clip": ["2", 0]},
      "class_type": "CLIPTextEncode",
      "_meta": {"title": "Positive Prompt"}
    },
    "5": {
      "inputs": {"text": "", "clip": ["2", 0]},
      "class_type": "CLIPTextEncode",
      "_meta": {"title": "Negative Prompt"}
    },
    "6": {
      "inputs": {
        "video": "base_video.mp4",
        "force_rate": 16,
        "force_size": "Custom",
        "custom_width": 832,
        "custom_height": 480,
        "frame_load_cap": 81,
        "skip_first_frames": 0,
        "select_every_nth": 1
      },
      "class_type": "VHS_LoadVideo",
      "_meta": {"title": "Private Base Video"}
    },
    "7": {
      "inputs": {"image": "identity_reference.png"},
      "class_type": "LoadImage",
      "_meta": {"title": "Approved KYC Reference"}
    },
    "8": {
      "inputs": {
        "width": 832,
        "height": 480,
        "length": 81,
        "batch_size": 1,
        "strength": 1.0,
        "positive": ["4", 0],
        "negative": ["5", 0],
        "vae": ["3", 0],
        "control_video": ["6", 0],
        "reference_image": ["7", 0]
      },
      "class_type": "WanVaceToVideo",
      "_meta": {"title": "Wan VACE Video To Video"}
    },
    "9": {
      "inputs": {
        "seed": 1,
        "steps": 30,
        "cfg": 5.0,
        "sampler_name": "uni_pc",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": ["1", 0],
        "positive": ["8", 0],
        "negative": ["8", 1],
        "latent_image": ["8", 2]
      },
      "class_type": "KSampler",
      "_meta": {"title": "Wan VACE Sampler"}
    },
    "10": {
      "inputs": {"samples": ["9", 0], "trim_amount": ["8", 3]},
      "class_type": "TrimVideoLatent",
      "_meta": {"title": "Trim Reference Latent"}
    },
    "11": {
      "inputs": {"samples": ["10", 0], "vae": ["3", 0]},
      "class_type": "VAEDecode",
      "_meta": {"title": "Decode Video Frames"}
    },
    "12": {
      "inputs": {
        "frame_rate": 16,
        "loop_count": 0,
        "filename_prefix": "privacy/wan-v2v",
        "format": "video/h264-mp4",
        "pingpong": false,
        "save_output": true,
        "images": ["11", 0]
      },
      "class_type": "VHS_VideoCombine",
      "_meta": {"title": "Save MP4"}
    }
  },
  "bindings": {
    "positive_prompt": {"node_id": "4", "input": "text"},
    "negative_prompt": {"node_id": "5", "input": "text"},
    "source_image": {"node_id": "7", "input": "image"},
    "base_video": {"node_id": "6", "input": "video"},
    "width": [
      {"node_id": "6", "input": "custom_width"},
      {"node_id": "8", "input": "width"}
    ],
    "height": [
      {"node_id": "6", "input": "custom_height"},
      {"node_id": "8", "input": "height"}
    ],
    "frames": [
      {"node_id": "6", "input": "frame_load_cap"},
      {"node_id": "8", "input": "length"}
    ],
    "fps": [
      {"node_id": "6", "input": "force_rate"},
      {"node_id": "12", "input": "frame_rate"}
    ],
    "steps": {"node_id": "9", "input": "steps"},
    "cfg": {"node_id": "9", "input": "cfg"},
    "seed": {"node_id": "9", "input": "seed"},
    "filename_prefix": {"node_id": "12", "input": "filename_prefix"},
    "v2v_model_name": {"node_id": "1", "input": "unet_name"},
    "text_encoder_name": {"node_id": "2", "input": "clip_name"},
    "vae_name": {"node_id": "3", "input": "vae_name"}
  },
  "output_nodes": ["12"]
}
