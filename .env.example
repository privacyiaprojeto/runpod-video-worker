# ComfyUI runtime
COMFYUI_ROOT=/opt/ComfyUI
WORKFLOW_ROOT=/app/workflows
MODEL_SOURCE_MODE=network_volume
RUNTIME_ROOT=/runpod-volume/privacy-wan-runtime
MODEL_ROOT=/runpod-volume/models
CACHED_MODEL_ID=
CACHED_MODEL_REVISION=
CACHED_MODEL_CACHE_ROOT=/runpod-volume/huggingface-cache/hub
# Conservative fail-closed floor for cached_model adapter/media/output workspace.
EPHEMERAL_MIN_FREE_GB=20
COMFYUI_START_LOCAL=true
COMFYUI_START_TIMEOUT_SECONDS=180
COMFYUI_JOB_TIMEOUT_SECONDS=3900
COMFYUI_POLL_INTERVAL_SECONDS=3

# Signed input download restrictions
MEDIA_ALLOWED_HOSTS=
ALLOW_PRIVATE_DOWNLOAD_HOSTS=false
DOWNLOAD_TIMEOUT_SECONDS=180
MAX_IMAGE_DOWNLOAD_MB=80
MAX_VIDEO_DOWNLOAD_MB=2048
MAX_OUTPUT_MB=2048

# Wan model file names in the Network Volume
WAN_I2V_MODEL_NAME=wan2.1_i2v_480p_14B_fp16.safetensors
WAN_V2V_MODEL_NAME=wan2.1_vace_14B_fp16.safetensors
WAN_TEXT_ENCODER_NAME=umt5_xxl_fp8_e4m3fn_scaled.safetensors
WAN_VAE_NAME=wan_2.1_vae.safetensors
WAN_CLIP_VISION_NAME=clip_vision_h.safetensors
SKIP_MODEL_VALIDATION=false

# Output. For production, prefer private_r2.
OUTPUT_MODE=private_r2
MAX_BASE64_RETURN_MB=80
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PREFIX=wan/private-tmp
R2_SIGNED_URL_TTL_SECONDS=900
IDENTITY_ONE_SHOT_LOCK_BACKEND=filesystem
IDENTITY_ONE_SHOT_LOCK_PREFIX=wan/private-tmp
